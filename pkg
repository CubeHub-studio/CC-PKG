local function antivirusScan(files)
  for _,f in ipairs(files or {}) do
    local hit,why=avSignatureScan(f.data); if hit then return false,"Signature scanner: "..why end
    hit,why=avHeuristicScan(f.data); if hit then return false,"Heuristic scanner: "..why end
    hit,why=avRepoScan(f.data); if hit then return false,"Community signature scanner: "..why end
  end
  return true
end
local function malwareWarning(repoUrl)
  print("")
  print("WARNING: This package has been flagged as malware. If you believe this is safe and an antivrus false positive has occured then click 1 20 times, if you wish to exit this screen with no changes made to this computer then press 2.")
  print("PKG antivirus may make mistakes, you can report the repository this package has came from.")
  print("SOURCE REPO: "..tostring(repoUrl or "Unknown"))
  local ones=0
  while true do
    local _,k=os.pullEvent("key")
    if k==keys["2"] then print("Installation cancelled. No package files were installed."); return false end
    if k==keys["1"] then ones=ones+1; print("Override confirmation "..ones.."/20"); if ones>=20 then return true end else ones=0 end
  end
end

local function collectPlan(name,plan,visiting,rootConstraint)
  plan=plan or {}; visiting=visiting or {}
  if visiting[name] then return nil,"circular dependency detected: "..name end
  local existing=plan[name]
  local e,v=find(name,rootConstraint); if not e then return nil,"package not found or no compatible version: "..name end
  local m,mp,er=manifest(e._repo,e,v); if not m then return nil,mp end
  if rootConstraint and not satisfies(m.version,rootConstraint) then
    return nil,name.." "..tostring(m.version).." does not satisfy "..tostring(rootConstraint)
  end
  if existing then
    if existing.version~=m.version then return nil,"dependency version conflict for "..name end
    return plan
  end
  for _,f in ipairs(m.files or {}) do
    if not safePath(f.path or f.source) then return nil,"unsafe package path: "..tostring(f.path or f.source) end
  end
  if computerType()=="pocket" and not isPocketVersion(m.version) then return nil,"version "..tostring(m.version).." is not a pocket version" end
  if computerType()=="computer" and isPocketVersion(m.version) then return nil,"version "..tostring(m.version).." is pocket-only" end
  visiting[name]=true
  local deps=manifestDependencies(m)
  for _,dep in ipairs(deps) do
    if not dep.name or dep.name=="" then return nil,"invalid dependency in "..name end
    local ok,why=collectPlan(dep.name,plan,visiting,dep.constraint)
    if not ok then return nil,why end
  end
  visiting[name]=nil
  plan[name]={name=name,entry=e,version=v,manifest=m,manifestPath=mp,deps=deps}
  return plan
end

local function downloadPlan(plan)
  local total=0
  for _,p in pairs(plan) do
    p.files={}
    for _,f in ipairs(p.manifest.files or {}) do
      local source=f.source or f.path
      local path=f.path or f.source
      local s,ce=get(url(p.entry._repo._base or p.entry._repo.url,source))
      if not s then return nil,"failed to download "..p.name.."/"..tostring(path)..": "..tostring(ce) end
      if #s>MAX_PACKAGE_FILE_SIZE then return nil,"file too large: "..tostring(path) end
      total=total+#s
      if total>MAX_PACKAGE_TOTAL_SIZE then return nil,"package dependency tree exceeds size limit" end
      local actual=sha256(s)
      local expected=f.sha256 or f.hash
      if expected and actual and tostring(expected):lower()~=tostring(actual):lower() then
        return nil,"SHA-256 mismatch for "..p.name.."/"..tostring(path)
      end
      p.files[#p.files+1]={path=path,data=s,sha256=actual}
    end
    local manifestHash=sha256(textutils.serialiseJSON(p.manifest))
    if p.manifest.sha256 and manifestHash and tostring(p.manifest.sha256):lower()~=manifestHash:lower() then
      return nil,"manifest SHA-256 mismatch for "..p.name
    end
    p.capabilities=packageCapabilities(p.files)
  end
  return true
end

local function orderedPlan(plan)
  local out={}
  local done={}
  local function visit(n)
    if done[n] then return end
    local p=plan[n]
    for _,d in ipairs(p.deps or {}) do if plan[d.name] then visit(d.name) end end
    done[n]=true; out[#out+1]=p
  end
  for n in pairs(plan) do visit(n) end
  return out
end

local function scanPlan(plan)
  for _,p in pairs(plan) do
    print("Scanning "..p.name.." "..tostring(p.manifest.version).."...")
    local clean,reason=antivirusScan(p.files)
    if not clean then
      if not malwareWarning(p.entry._repo.url) then return false,"cancelled by user" end
    end
  end
  return true
end

local function install(name)
  logLine(LOG_FILE,"INSTALL TRANSACTION "..tostring(name).." on "..computerType())
  local plan,err=collectPlan(name); if not plan then return fail(err) end
  local d=db(); d.backups=d.backups or {}
  local lock=lockData()
  local order=orderedPlan(plan)
  print("Preparing "..#order.." package(s)...")
  local ok,why=downloadPlan(plan)
  if not ok then return fail(why) end
  local scanned,scanWhy=scanPlan(plan)
  if not scanned then return false end
  print("All packages passed the pre-install scan.")
  local backups={}
  for _,p in ipairs(order) do
    local old=d.packages[p.name]
    if old and old.version==p.manifest.version and old.target==computerType() then
      print(p.name.." "..p.manifest.version.." is already installed.")
    else
      local backup=backupPackageFiles(p.name,p.manifest.files)
      backups[#backups+1]={name=p.name,path=backup}
      if backup then print("Backup created for "..p.name..": "..backup) end
    end
  end
  local written={}
  for _,p in ipairs(order) do
    local old=d.packages[p.name]
    if not (old and old.version==p.manifest.version and old.target==computerType()) then
      for _,f in ipairs(p.files) do
        local safe=safePath(f.path)
        if not safe then
          for _,b in ipairs(backups) do if b.path then restoreBackup(b.path) end end
          return fail("unsafe package path during commit: "..tostring(f.path))
        end
        local dir=fs.getDir(safe)
        if dir~="" and not fs.exists(dir) then fs.makeDir(dir) end
        local h=fs.open(safe,"w")
        if not h then
          for _,b in ipairs(backups) do if b.path then restoreBackup(b.path) end end
          for _,w in ipairs(written) do
            local hadBackup=false
            local rel=w:gsub("^/","")
            for _,b in ipairs(backups) do if b.path and fs.exists(b.path.."/"..rel) then hadBackup=true end end
            if not hadBackup and fs.exists(w) then fs.delete(w) end
          end
          return fail("cannot write "..tostring(safe))
        end
        h.write(f.data); h.close()
        written[#written+1]=safe
      end
      local hashes={}
      for _,f in ipairs(p.files) do hashes[f.path]=f.sha256 end
      d.packages[p.name]={
        version=p.manifest.version,target=computerType(),files=p.manifest.files or {},
        ownedFiles=(function()
          local seen={}
          local out={}
          if old and old.ownedFiles then
            for _,path in ipairs(old.ownedFiles) do
              if not seen[path] then seen[path]=true; out[#out+1]=path end
            end
          end
          for _,f in ipairs(p.manifest.files or {}) do
            local path=f.path or f.source
            if path and not seen[path] then seen[path]=true; out[#out+1]=path end
          end
          return out
        end)(),
        repository=p.entry._repo.name,backup=(function() for _,b in ipairs(backups) do if b.name==p.name then return b.path end end end)(),
        dependencies=copyValue(p.deps or {}),explicit=(p.name==name),
        sha256=hashes,capabilities=p.capabilities or {},author=p.manifest.author,
        license=p.manifest.license,homepage=p.manifest.homepage,readme=p.manifest.readme,
        changelog=p.manifest.changelog
      }
      lock.packages[p.name]={version=p.manifest.version,target=computerType(),repository=p.entry._repo.name,sha256=hashes}
    end
  end
  saveDb(d); saveLock(lock)
  print("Transaction committed successfully.")
  print("Installed "..name.." and "..tostring(#order-1).." dependency/dependencies.")
  return true
end


local function packageOwnedFiles(p)
  local out={}
  local seen={}
  for _,f in ipairs(p.files or {}) do
    local path=f.path or f.source
    local safe=safePath(path)
    if safe and not seen[safe] then
      seen[safe]=true
      out[#out+1]=safe
    end
  end
  for _,path in ipairs(p.ownedFiles or {}) do
    local safe=safePath(path)
    if safe and not seen[safe] then
      seen[safe]=true
      out[#out+1]=safe
    end
  end
  return out
end

local function removePackageFiles(name,d,p)
  local owned=packageOwnedFiles(p)
  local shared={}
  for otherName,other in pairs(d.packages or {}) do
    if otherName~=name then
      for _,path in ipairs(packageOwnedFiles(other)) do
        shared[path]=true
      end
    end
  end

  local removed=0
  local skipped=0
  local dirs={}
  for _,path in ipairs(owned) do
    if not shared[path] and fs.exists(path) and not fs.isReadOnly(path) then
      fs.delete(path)
      removed=removed+1
    elseif shared[path] then
      skipped=skipped+1
    end
    local dir=fs.getDir(path)
    while dir and dir~="" and dir~="/" and dir~=".ccpkg" and dir:sub(1,8)~=".ccpkg/" do
      dirs[#dirs+1]=dir
      local parent=fs.getDir(dir)
      if parent==dir then break end
      dir=parent
    end
  end

  local seenDirs={}
  for i=#dirs,1,-1 do
    local dir=dirs[i]
    if not seenDirs[dir] and fs.exists(dir) and fs.isDir(dir) and not fs.isReadOnly(dir) then
      seenDirs[dir]=true
      if #fs.list(dir)==0 then
        fs.delete(dir)
      end
    end
  end
  return removed,skipped
end

local function remove(name,force)
  logLine(LOG_FILE,"REMOVE "..tostring(name))
  local d=db(); local p=d.packages[name]
  if not p then return fail("package is not installed: "..name) end
  local dependents={}
  for n,x in pairs(d.packages or {}) do
    if n~=name then
      for _,dep in ipairs(x.dependencies or {}) do if dependencySpec(dep)==name then dependents[#dependents+1]=n end end
    end
  end
  if #dependents>0 and not force then
    print("Cannot remove "..name..". Installed packages depend on it:")
    for _,n in ipairs(dependents) do print("  "..n) end
    print("Use: pkg remove "..name.." --force")
    return false
  end
  local owned=packageOwnedFiles(p)
  local backup=backupPackageFiles(name,owned)
  if backup then print("Backup created: "..backup) end
  local removed,skipped=removePackageFiles(name,d,p)
  d.backups=d.backups or {}; d.backups[name]=backup
  d.packages[name]=nil
  local lock=lockData(); lock.packages[name]=nil
  saveDb(d); saveLock(lock)
  print("Removed "..name.." and "..removed.." owned file(s).")
  if skipped>0 then print("Kept "..skipped.." shared file(s) used by other installed packages.") end
  print("Empty package directories were also removed.")
  return true
end

local function verifyPackage(name)
  local d=db(); local p=d.packages[name]
  if not p then return fail("package is not installed: "..name) end
  local good=true; local count=0
  for _,f in ipairs(p.files or {}) do
    local path=safePath(f.path or f.source)
    if not path or not fs.exists(path) then print("MISSING: "..tostring(f.path)); good=false
    elseif fs.isDir(path) then print("INVALID: "..tostring(f.path).." is a directory"); good=false
    else
      count=count+1
      local actual=fileSha256(path)
      local expected=p.sha256 and p.sha256[f.path]
      if expected and actual~=expected then print("MODIFIED: "..tostring(f.path)); good=false end
    end
  end
  if good then print("✓ "..name.." verified ("..count.." file(s)).") else print("✗ "..name.." failed verification.") end
  return good
end

local function audit()
  local d=db(); local n=0
  for name in pairs(d.packages or {}) do n=n+1; print("Auditing "..name.."..."); verifyPackage(name) end
  if n==0 then print("No installed packages.") end
end

local function inspectPackage(name)
  local e,v=find(name); if not e then return fail(v) end
  local m,mp=manifest(e._repo,e,v); if not m then return fail(mp) end
  print("Name: "..tostring(m.name or name))
  print("Version: "..tostring(m.version or v))
  print("Repository: "..tostring(e._repo.name))
  print("Target: "..computerType())
  print("Author: "..tostring(m.author or "Unknown"))
  print("License: "..tostring(m.license or "Not specified"))
  print("Homepage: "..tostring(m.homepage or "Not specified"))
  print("Description: "..tostring(m.description or ""))
  print("Dependencies: "..tostring(#manifestDependencies(m)))
  print("Files: "..tostring(#(m.files or {})))
  print("Readme: "..tostring(m.readme or "Not specified"))
  print("Changelog: "..tostring(m.changelog or "Not specified"))
  print("Manifest: "..tostring(mp))
  local temp={}; for _,f in ipairs(m.files or {}) do
    local s=get(url(e._repo._base or e._repo.url,f.source or f.path))
    if s then temp[#temp+1]={path=f.path or f.source,data=s} end
  end
  print("Capabilities: "..capabilityText(packageCapabilities(temp)))
  local clean,reason=antivirusScan(temp)
  print("Antivirus: "..(clean and "CLEAN" or ("FLAGGED: "..tostring(reason))))
end

local function testPackage(name)
  local plan,err=collectPlan(name); if not plan then return fail(err) end
  local ok,why=downloadPlan(plan); if not ok then return fail(why) end
  local clean,reason=scanPlan(plan)
  print("Manifest/dependency validation: PASS")
  print("Path validation: PASS")
  print("Download validation: PASS")
  print("Antivirus: "..(clean and "PASS" or "FLAGGED"))
  if not clean then print("Reason: "..tostring(reason)) end
  return clean
end

local function doctor()
  print("CC PKG Doctor")
  print("Version: "..PKG_VERSION)
  local checks={
    {"config",CONFIG_FILE},{"database",DB_FILE},{"lockfile",LOCK_FILE}
  }
  for _,x in ipairs(checks) do print((fs.exists(x[2]) and "✓ " or "⚠ ")..x[1]..": "..x[2]) end
  print("Antivirus signatures: "..(get(AV_REPO.."signatures.json") and "✓ available" or "⚠ unavailable"))
  local c=config(); for _,r in ipairs(c.repositories or {}) do local i,e=index(r); print((i and "✓ " or "✗ ").."repository "..tostring(r.name)..(i and "" or ": "..tostring(e))) end
  local d=db(); for n in pairs(d.packages or {}) do verifyPackage(n) end
  print("Doctor check complete.")
end

local function clean()
  if not fs.exists(BACKUP_DIR) then print("Nothing to clean."); return true end
  local removed=0
  for _,n in ipairs(fs.list(BACKUP_DIR)) do
    local p=BACKUP_DIR.."/"..n
    fs.delete(p); removed=removed+1
  end
  local tmp=CONFIG_DIR.."/pkg.new"; if fs.exists(tmp) then fs.delete(tmp) end
  print("Removed "..removed.." backup/temp item(s).")
  return true
end

local function autoremove()
  local d=db(); local needed={}
  for _,p in pairs(d.packages or {}) do
    if not p.explicit then
      -- Non-explicit packages may still be needed by an explicit package.
    end
  end
  for _,p in pairs(d.packages or {}) do
    for _,dep in ipairs(p.dependencies or {}) do local n=dependencySpec(dep); if n then needed[n]=true end end
  end
  local removed=0
  for n in pairs(d.packages or {}) do
    if p.explicit==false and not needed[n] then
      local ok=remove(n,false)
      if ok then removed=removed+1 end
    end
  end
  print("Autoremove complete. Removed "..removed.." package(s).")
end

local function recovery()
  print("CC PKG Recovery")
  if fs.exists("/pkg") then print("✓ /pkg exists") else print("✗ /pkg missing") end
  if fs.exists(DB_FILE) then print("✓ installed database exists") else print("⚠ installed database missing") end
  if fs.exists(LOCK_FILE) then print("✓ lockfile exists") else print("⚠ lockfile missing") end
  print("Use 'pkg restore <package>' for package backups.")
  print("Use 'pkg self-update' to restore the PKG client from the official repository.")
end

local function search(q)
  q=(q or ""):lower(); local n=0
  for _,r in ipairs(config().repositories or {}) do local i=index(r)
    if i then for name,e in pairs(i.packages or {}) do
      local h=(name.." "..(e.description or "")):lower()
      if q=="" or h:find(q,1,true) then
        local count=0; for _ in pairs(e.versions or {}) do count=count+1 end
        print(name.." - "..(e.description or "").." ("..count.." versions)")
        n=n+1
      end
    end end
  end
  if n==0 then print("No packages found.") end
end
