local function repoAdd(repoUrl)
  if not repoUrl or repoUrl=="" then return fail("repository URL is required") end
  if not repoUrl:match("^https?://") then return fail("repository URL must start with http:// or https://") end
  local c=config()
  c.repositories=c.repositories or {}
  if repoUrl:sub(-1)~="/" then repoUrl=repoUrl.."/" end
  local metaUrl=repoUrl.."repometadata.json"
  local meta,e=get(metaUrl)
  if not meta then return fail("could not download repometadata.json: "..tostring(e)) end
  local ok,data=pcall(textutils.unserialiseJSON,meta)
  if not ok or type(data)~="table" or type(data.name)~="string" or data.name=="" then return fail("invalid repometadata.json: missing repository name") end
  local name=data.name
  for _,r in ipairs(c.repositories) do if r.name==name then return fail("repository already exists: "..name) end end
  local test={name=name,url=repoUrl}
  local i,ie=index(test)
  if not i then return fail("repository check failed: "..tostring(ie)) end
  c.repositories[#c.repositories+1]=test
  if not writeJson(CONFIG_FILE,c) then return fail("could not save repository configuration") end
  print("Added repository "..name.." - "..repoUrl)
  return true
end

local function repoRemove(name)
  if not name or name=="" then return fail("repository name is required") end
  local c=config()
  local list=c.repositories or {}
  for i,r in ipairs(list) do
    if r.name==name then
      if name=="official" then return fail("cannot remove the official repository") end
      table.remove(list,i)
      if not writeJson(CONFIG_FILE,c) then return fail("could not save repository configuration") end
      print("Removed repository "..name..".")
      return true
    end
  end
  return fail("repository not found: "..name)
end

local function repoUpdate()
  local c=config()
  local count=0
  for _,r in ipairs(c.repositories or {}) do
    local i,e=index(r)
    if i then
      local packageCount=0; for _ in pairs(i.packages or {}) do packageCount=packageCount+1 end
      print((r.name or "unnamed").." - ONLINE | "..packageCount.." package(s)")
      count=count+1
    else
      print((r.name or "unnamed").." - OFFLINE/INVALID: "..tostring(e))
    end
  end
  print("Healthy repositories: "..count.."/"..tostring(#(c.repositories or {})))
end
local function checkForUpdate()
  local api="https://api.github.com/repos/CubeHub-studio/CC-PKG/releases/latest"
  local s=get(api)
  if not s then return false end
  local ok,data=pcall(textutils.unserialiseJSON,s)
  if not ok or type(data)~="table" or type(data.tag_name)~="string" then return false end
  local latest=data.tag_name:gsub("^v","")
  local function ver(v)
    local a={}
    for x in tostring(v):gmatch("%d+") do a[#a+1]=tonumber(x) end
    return (a[1] or 0)*1000000+(a[2] or 0)*1000+(a[3] or 0)
  end
  if ver(latest)>ver(PKG_VERSION) then
    print("CC PKG: Update available! "..PKG_VERSION.." -> "..latest)
    print("Run pkg self-update to update.")
    return true
  end
  return false
end

local function restorePackage(name)
  local d=db(); local p=d.packages[name]
  local root=(p and p.backup) or (d.backups and d.backups[name])
  if not root then return fail("no backup available for "..name) end
  if restoreBackup(root) then
    if d.backups then d.backups[name]=nil end
    saveDb(d)
    print("Restored "..name.." from backup.")
    return true
  end
  return fail("could not restore backup for "..name)
end

local function selfUpdate()
  print("Checking for CC PKG updates...")
  local s,e=get(PKG_SOURCE)
  if not s then return fail("failed to download latest pkg: "..tostring(e)) end
  local tmp="/.ccpkg/pkg.new"
  local h=fs.open(tmp,"w")
  if not h then return fail("cannot create temporary update file") end
  h.write(s); h.close()
  local check=fs.open(tmp,"r")
  if not check then return fail("cannot verify downloaded pkg") end
  local downloaded=check.readAll(); check.close()
  if downloaded=="" then fs.delete(tmp); return fail("downloaded pkg is empty") end
  local old="/pkg"
  local target=fs.open(old,"w")
  if not target then
    if fs.exists(tmp) then fs.delete(tmp) end
    return fail("could not open /pkg for updating")
  end
  target.write(downloaded)
  target.close()
  fs.delete(tmp)
  print("CC PKG updated to the latest version.")
  print("Run pkg help to load the updated client.")
  return true
end
local function upgrade()
  local d=db(); local names={}
  for n in pairs(d.packages or {}) do names[#names+1]=n end
  for _,n in ipairs(names) do
    local e,v=find(n)
    if e then
      local m=manifest(e._repo,e,v)
      if m and (tostring(m.version)~=tostring(d.packages[n].version) or d.packages[n].target~=computerType()) then install(n)
      else print(n.." is up to date.") end
    end
  end
end
