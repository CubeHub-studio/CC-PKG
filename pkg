  for k,x in pairs(v) do t[k]=copyValue(x) end
  return t
end

-- Pure-Lua SHA-256 using CC:Tweaked's bit32 API.
local function sha256(data)
  data=tostring(data or "")
  if not bit32 then return nil,"bit32 unavailable" end
  local K={
    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
    0xd807aa98,0x12835b014,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
  }
  local H={0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19}
  local len=#data
  data=data..string.char(0x80)
  local rem=(#data)%64
  local pad=(rem<=56) and (56-rem) or (120-rem)
  data=data..string.rep("\0",pad)
  local bitLen=len*8
  local hi=math.floor(bitLen/4294967296)
  local lo=bitLen-hi*4294967296
  local function be32(n)
    return string.char(
      math.floor(n/16777216)%256,
      math.floor(n/65536)%256,
      math.floor(n/256)%256,
      n%256
    )
  end
  data=data..be32(hi)..be32(lo)
  local function u32(n) return bit32.band(n,0xffffffff) end
  local function add(...) local r=0; for i=1,select("#",...) do r=r+select(i,...) end; return r%4294967296 end
  local function rotr(x,n) return bit32.rshift(x,n)+bit32.lshift(x,32-n) end
  local function read32(i) return u32(data:byte(i)*16777216+data:byte(i+1)*65536+data:byte(i+2)*256+data:byte(i+3)) end
  for base=1,#data,64 do
    local W={}
    for i=0,15 do W[i]=read32(base+i*4) end
    for i=16,63 do
      local x=W[i-15]; local y=W[i-2]
      local s0=bit32.bxor(rotr(x,7),rotr(x,18),bit32.rshift(x,3))
      local s1=bit32.bxor(rotr(y,17),rotr(y,19),bit32.rshift(y,10))
      W[i]=add(W[i-16],s0,W[i-7],s1)
    end
    local a,b,d,e,f,g,h=H[1],H[2],H[4],H[5],H[6],H[7],H[8]
    local cc=H[3]
    for i=0,63 do
      local S1=bit32.bxor(rotr(e,6),rotr(e,11),rotr(e,25))
      local ch=bit32.bxor(bit32.band(e,f),bit32.band(bit32.bnot(e),g))
      local temp1=add(h,S1,ch,K[i+1],W[i])
      local S0=bit32.bxor(rotr(a,2),rotr(a,13),rotr(a,22))
      local maj=bit32.bxor(bit32.band(a,b),bit32.band(a,cc),bit32.band(b,cc))
      local temp2=add(S0,maj)
      h=g; g=f; f=e; e=add(d,temp1); d=cc; cc=b; b=a; a=add(temp1,temp2)
    end
    H[1]=add(H[1],a); H[2]=add(H[2],b); H[3]=add(H[3],cc); H[4]=add(H[4],d)
    H[5]=add(H[5],e); H[6]=add(H[6],f); H[7]=add(H[7],g); H[8]=add(H[8],h)
  end
  local out={}
  for i=1,8 do
    local x=H[i]
    out[#out+1]=string.format("%08x",x)
  end
  return table.concat(out)
end

local function fileSha256(path)
  local h=fs.open(path,"rb"); if not h then return nil end
  local d=h.readAll(); h.close()
  return sha256(d)
end

