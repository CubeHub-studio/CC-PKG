local function parseConstraint(c)
  c=tostring(c or "*")
  local out={}
  for op,ver in c:gmatch("([<>~=%^]*)%s*v?([%d%.]+)") do
    out[#out+1]={op=op,version=ver}
  end
  if #out==0 and c~="*" then out[1]={op="=",version=c:gsub("^v","")} end
  return out
end

local function satisfies(version,constraint)
  if not constraint or constraint=="" or constraint=="*" then return true end
  local vn=versionNumber(version)
  for _,r in ipairs(parseConstraint(constraint)) do
    local n=versionNumber(r.version)
    local op=r.op
    if op==">" and not (vn>n) then return false end
    if op==">=" and not (vn>=n) then return false end
    if op=="<" and not (vn<n) then return false end
    if op=="<=" and not (vn<=n) then return false end
    if op=="=" or op=="" then if vn~=n then return false end end
    if op=="~" and not (vn>=n and vn<math.floor(n/1000)*1000+1000) then return false end
    if op=="^" and not (vn>=n and vn<math.floor(n/1000000)*1000000+1000000) then return false end
  end
  return true
end

local function dependencySpec(d)
  if type(d)=="string" then return d,"*" end
  if type(d)=="table" then return d.name or d[1],d.version or d.constraint or "*" end
  return nil,"*"
end

local function manifestDependencies(m)
  local result={}
  if type(m.dependencies)=="table" then
    for k,v in pairs(m.dependencies) do
      local n,c=dependencySpec(type(k)=="number" and v or {name=k,version=v})
      if n then result[#result+1]={name=n,constraint=c} end
    end
  end
  return result
end

local function packageCapabilities(files)
  local caps={}
  local seen={}
  local function add(x) if not seen[x] then seen[x]=true; caps[#caps+1]=x end end
  for _,f in ipairs(files or {}) do
    local s=tostring(f.data or ""):lower()
    if s:find("fs%.") or s:find("io%.open") then add("filesystem") end
    if s:find("http%.") or s:find("websocket") then add("network") end
    if s:find("redstone%.") or s:find("rs%.") then add("redstone") end
    if s:find("rednet%.") then add("rednet") end
    if s:find("peripheral%.") then add("peripherals") end
    if s:find("turtle%.") then add("turtle/world") end
    if s:find("commands%.") then add("Minecraft commands") end
    if s:find("shell%.") or s:find("os%.run") then add("program execution") end
    if s:find("settings%.") then add("settings") end
    if s:find("multishell%.") then add("multishell") end
    if s:find("disk%.") then add("disk") end
    if s:find("term%.") or s:find("window%.") then add("terminal UI") end
  end
  return caps
end

local function capabilityText(caps)
  return (#caps==0 and "none" or table.concat(caps,", "))
end


